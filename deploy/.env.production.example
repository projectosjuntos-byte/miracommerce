DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=shop.example.ao
CSRF_TRUSTED_ORIGINS=https://shop.example.ao

DB_ENGINE=django.db.backends.mysql
DB_NAME=miracommerce
DB_USER=miracommerce
DB_PASSWORD=replace-with-a-database-password
DB_ROOT_PASSWORD=replace-with-a-root-password
DB_HOST=db
DB_PORT=3306
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
USE_REDIS_CACHE=True
CACHE_TIMEOUT=900
CATALOG_PAGE_SIZE=24
RECOMMENDATION_LOOKBACK_DAYS=365
RECOMMENDATION_MAX_TRANSACTIONS=20000
RECOMMENDATION_MAX_ITEMS_PER_TRANSACTION=50
RECOMMENDATION_MIN_SUPPORT=0.01
RECOMMENDATION_MIN_LIFT=1.0
RECOMMENDATION_MAX_RULES=500

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=MiraComerce <no-reply@example.ao>
SERVER_EMAIL=errors@example.ao

# Use S3, MinIO or another S3-compatible provider in production. Keep the
# bucket private when AWS_S3_QUERYSTRING_AUTH=True (the default).
MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
AWS_STORAGE_BUCKET_NAME=miracommerce-media
AWS_S3_REGION_NAME=af-south-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret-key
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_QUERYSTRING_AUTH=True
# Origem HTTPS que entrega as imagens externas; também é autorizada pela CSP.
MEDIA_CDN_URL=https://media.shop.example.ao
REQUIRE_EXTERNAL_MEDIA_STORAGE=True
DATA_RETENTION_DAYS=1825

# Nunca ative pagamentos simulados numa instalação pública. Um gateway deve
# confirmar o pagamento (por webhook assinado) antes de o pedido ser marcado como pago.
SIMULATED_PAYMENTS_ENABLED=False

# Só ative quando o proxy Nginx fornecido estiver à frente do Gunicorn.
TRUST_PROXY_HEADERS=True
METRICS_TOKEN=replace-with-a-long-monitoring-token
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
CSP_ENFORCE=True
CSP_ALLOW_INLINE_STYLE_ATTRIBUTES=True
SECURE_SSL_REDIRECT=True
