SECRET_KEY=troque-por-uma-chave-forte-com-pelo-menos-50-caracteres
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ==============================================================================
# BANCO DE DADOS
# Opção 1 (Recomendado para Vercel): DATABASE_URL direta (PostgreSQL ou MySQL)
# Suporta: Neon, Supabase, Railway, PlanetScale, Aiven, Render
# Exemplos:
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=mysql://root:senha@monorail.proxy.rlwy.net:12345/railway
# ==============================================================================
# DATABASE_URL=

# Opção 2: Credenciais granulares (padrão local XAMPP / MySQL)
DB_NAME=ecommerce_inteligente
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ENGINE=django.db.backends.mysql

# Flag de ambiente Serverless / Vercel
# VERCEL=1

# Cache e performance
USE_REDIS_CACHE=False
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CACHE_TIMEOUT=900
RECOMENDACAO_CACHE_TIMEOUT=3600
CATALOG_PAGE_SIZE=24
RECOMMENDATION_LOOKBACK_DAYS=365
RECOMMENDATION_MAX_TRANSACTIONS=20000
RECOMMENDATION_MAX_ITEMS_PER_TRANSACTION=50
RECOMMENDATION_MIN_SUPPORT=0.01
RECOMMENDATION_MIN_LIFT=1.0
RECOMMENDATION_MAX_RULES=500
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
MEDIA_STORAGE_BACKEND=django.core.files.storage.FileSystemStorage
FRETE_GRATIS_MINIMO=25000.00
FRETE_PADRAO=0.00
AUTH_RATE_LIMIT_ENABLED=True
AUTH_LOGIN_RATE_LIMIT=10
AUTH_PASSWORD_RESET_RATE_LIMIT=5
DATA_RETENTION_DAYS=1825
SIMULATED_PAYMENTS_ENABLED=True
TRUST_PROXY_HEADERS=False

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=MiraComerce IA <seu-email@gmail.com>
SERVER_EMAIL=seu-email@gmail.com
